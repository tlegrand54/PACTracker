<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PACTracker.ViewModels"
             x:Class="PACTracker.Views.AddEnergyPage"
             x:DataType="vm:AddEnergyViewModel"
             Title="Nouvelle saisie">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <VerticalStackLayout Spacing="4">
                <Label Text="Date" FontAttributes="Bold" />
                <DatePicker Date="{Binding SelectedDate}"
                            MaximumDate="{Binding MaximumDate}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Consommation électrique (kWh)" FontAttributes="Bold" />
                <Entry Placeholder="ex : 12,5"
                       Keyboard="Numeric"
                       Text="{Binding ConsumptionText}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Production de chaleur (kWh)" FontAttributes="Bold" />
                <Entry Placeholder="ex : 38,0"
                       Keyboard="Numeric"
                       Text="{Binding ProductionText}" />
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding HasError}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Annuler"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="1"
                        Text="Enregistrer"
                        Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>