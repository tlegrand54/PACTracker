<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PACTracker.ViewModels"
             xmlns:resources="clr-namespace:PACTracker.Resources.Translation"
             x:Class="PACTracker.Views.AddEnergyPage"
             x:DataType="vm:AddEnergyViewModel"
             Title="{x:Static resources:AppResources.AddEnergyPageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static resources:AppResources.DateLabel}" FontAttributes="Bold" />
                <DatePicker Date="{Binding SelectedDate}"
                            MaximumDate="{Binding MaximumDate}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static resources:AppResources.ElectricityConsumptionLabel}" FontAttributes="Bold" />
                <Entry Placeholder="{x:Static resources:AppResources.ConsumptionPlaceholder}"
                       Keyboard="Numeric"
                       Text="{Binding ConsumptionText}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static resources:AppResources.HeatProductionLabel}" FontAttributes="Bold" />
                <Entry Placeholder="{x:Static resources:AppResources.ProductionPlaceholder}"
                       Keyboard="Numeric"
                       Text="{Binding ProductionText}" />
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding HasError}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="{x:Static resources:AppResources.CancelButton}"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="1"
                        Text="{x:Static resources:AppResources.SaveButton}"
                        Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>