<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PACTracker.ViewModels"
             xmlns:models="clr-namespace:PACTracker.Models"
             xmlns:resources="clr-namespace:PACTracker.Resources.Translation"
             x:Class="PACTracker.Views.EnergyPage"
             x:DataType="vm:EnergyViewModel"
             Title="{x:Static resources:AppResources.EnergyPageTitle}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="32">

        <!-- 1 and 2: back and add buttons -->
        <Button Grid.Row="0"  Text="{x:Static resources:AppResources.AddEnergyButton}" Command="{Binding AddEntryCommand}" />

        <Grid Grid.Row="1" RowDefinitions="Auto, *" RowSpacing="8">
            <!-- 3a: table header -->
            <Grid Grid.Row="0" ColumnDefinitions="1.4*,*,*,*">
                <Label Grid.Column="0" Text="{x:Static resources:AppResources.DateLabel}" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="{x:Static resources:AppResources.ProductionLabel}" FontAttributes="Bold" />
                <Label Grid.Column="2" Text="{x:Static resources:AppResources.ConsumptionShortLabel}" FontAttributes="Bold" />
                <Label Grid.Column="3" Text="{x:Static resources:AppResources.CopLabel}" FontAttributes="Bold" />
            </Grid>

            <!-- 3b: table rows -->
            <CollectionView Grid.Row="1" ItemsSource="{Binding Records}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EnergyModel">
                        <Grid ColumnDefinitions="1.4*,*,*,*" Padding="0,6">
                            <Label Grid.Column="0" Text="{Binding Date, StringFormat='{0:dd/MM}'}" />
                            <Label Grid.Column="1" Text="{Binding Production, StringFormat='{0:F1}'}" />
                            <Label Grid.Column="2" Text="{Binding Consumption, StringFormat='{0:F1}'}" />
                            <Label Grid.Column="3" Text="{Binding Cop, StringFormat='{0:F2}', TargetNullValue='-'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>        

        <!-- 4: monthly totals -->
        <Border Grid.Row="2" Padding="12" StrokeShape="RoundRectangle 8">
            <Grid ColumnDefinitions="*,*,*">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="{x:Static resources:AppResources.ProductionLabel}" FontSize="12" />
                    <Label Text="{Binding TotalProduction, StringFormat='{0:F1} kWh'}" FontAttributes="Bold" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="{x:Static resources:AppResources.ConsumptionLabel}" FontSize="12" />
                    <Label Text="{Binding TotalConsumption, StringFormat='{0:F1} kWh'}" FontAttributes="Bold" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2">
                    <Label Text="{x:Static resources:AppResources.MonthlyCopLabel}" FontSize="12" />
                    <Label Text="{Binding MonthCop, StringFormat='{0:F2}', TargetNullValue='-'}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>