<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PACTracker.ViewModels"
             x:Class="PACTracker.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Paramètres">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Sauvegarder et transférer"
                   FontSize="22"
                   FontAttributes="Bold" />

            <Label Text="Exportez vos mesures dans un fichier JSON pour les sauvegarder ou les transférer vers un autre appareil. Importez ensuite ce fichier dans PACTracker."
                   LineBreakMode="WordWrap" />

            <Button Text="Exporter mes données"
                    Command="{Binding ExportCommand}" />

            <Button Text="Importer un fichier"
                    Command="{Binding ImportCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding StatusMessage}"
                   LineBreakMode="WordWrap" />

            <Label Text="À l’import, les mesures du fichier remplacent celles déjà présentes pour les mêmes dates. Les autres mesures sont conservées."
                   FontSize="12"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
