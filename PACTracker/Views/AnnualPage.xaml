<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PACTracker.ViewModels"
             x:Class="PACTracker.Views.AnnualPage"
             x:DataType="vm:AnnualPageViewModel"
             Title="Comparaison annuelle">

    <CollectionView ItemsSource="{Binding Cards}" Margin="16">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:YearCardViewModel">
                <Border Padding="16" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding Year}" FontSize="20" FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Production" FontSize="12" />
                                <Label Text="{Binding Production, StringFormat='{0:F0} kWh'}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Consommation" FontSize="12" />
                                <Label Text="{Binding Consumption, StringFormat='{0:F0} kWh'}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2">
                                <Label Text="COP" FontSize="12" />
                                <Label Text="{Binding Cop, StringFormat='{0:F2}', TargetNullValue='-'}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>