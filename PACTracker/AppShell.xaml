<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PACTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PACTracker.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
    Shell.TabBarForegroundColor="#0D47A1"
    Shell.TabBarTitleColor="#0D47A1"
    Shell.TabBarUnselectedColor="#808080">

    <TabBar>
        <ShellContent Title="Accueil" Icon="home_icon.png" Route="EnergyPage"
                      ContentTemplate="{DataTemplate views:EnergyPage}" />
        <ShellContent Title="Annuel" Icon="annual_icon.png" Route="AnnualPage"
                      ContentTemplate="{DataTemplate views:AnnualPage}" />
        <ShellContent Title="Mensuel" Icon="monthly_icon.png" Route="ComparatifGraphPage"
                      ContentTemplate="{DataTemplate views:ComparatifGraphPage}" />
    </TabBar>

</Shell>
